  amphoe_code    String?   @db.VarChar(2)
  amphoe_name_th String?   @db.VarChar(100)
  province_code  String?   @db.VarChar(2)
  record_status  String?   @default("N") @db.Char(1)
  create_dtm     DateTime? @default(now()) @db.Timestamptz(6)
  create_by      String?   @db.Uuid
  update_dtm     DateTime? @db.Timestamptz(6)
  update_by      String?   @db.Uuid

  @@index([amphoe_name_th], map: "idx_tb_ms_amphoe_name")
  @@index([province_code], map: "idx_tb_ms_amphoe_province")
  @@schema("mas")
}

