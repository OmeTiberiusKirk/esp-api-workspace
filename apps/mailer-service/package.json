{
  "name": "@esp/mailer-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "apps/mailer-service/dist",
          "main": "apps/mailer-service/src/main.ts",
          "tsConfig": "apps/mailer-service/tsconfig.build.json",
          "rootDir": "apps/mailer-service/src",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/mailer-service/src/app/mailer/assets",
              "output": "app/mailer/assets"
            }
          ],
          "generatePackageJson": false
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/mailer-service/dist/package.json",
          "{workspaceRoot}/apps/mailer-service/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/mailer-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@esp/mailer-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@esp/mailer-service:build:development"
          },
          "production": {
            "buildTarget": "@esp/mailer-service:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@esp/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1"
  }
}
