generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

generator nestjsDto {
  provider                    = "prisma-generator-nestjs-dto"
  output                      = "../src/generated/nestjs-dto"
  createDtoPrefix             = "Create"
  definiteAssignmentAssertion = "true"
  dtoSuffix                   = "Dto"
  noDependencies              = "true"
  prettier                    = "true"
  updateDtoPrefix             = "Update"
}

datasource db {
  provider = "postgresql"
  schemas  = ["reg"]
}

