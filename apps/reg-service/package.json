{
  "name": "@esp/reg-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "dependsOn": ["^build"],
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "apps/reg-service/dist",
          "main": "apps/reg-service/src/main.ts",
          "tsConfig": "apps/reg-service/tsconfig.build.json",
          "rootDir": "apps/reg-service/src",
          "assets": ["apps/reg-service/src/assets"],
          "generatePackageJson": false
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/reg-service/dist/package.json",
          "{workspaceRoot}/apps/reg-service/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/reg-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@esp/reg-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@esp/reg-service:build:development"
          },
          "production": {
            "buildTarget": "@esp/reg-service:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@esp/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@brakebein/prisma-generator-nestjs-dto": "^1.30.0",
    "@nestjs/testing": "catalog:",
    "@types/pg": "^8.20.4",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1"
  }
}
